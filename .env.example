BOT_TOKEN=
ADMIN_IDS=

# Прод: 82800 и 3600. Для проверки: 120 и 30.
ROUND_SECONDS=82800
TALLY_SECONDS=3600
# Сетка расписания (UTC): день открывается в этот час, голосование до (час-1):00,
# час подсчёта — и сразу после него итоги с новым днём.
DAY_OPEN_HOUR_UTC=11
# Час закрытия голосования (UTC): сразу после него — мгновенный подсчёт,
# итоги, выплаты и запуск следующего дня (без часа простоя).
DAY_CLOSE_HOUR_UTC=11
# Час прегенерации следующего дня (UTC): глава/арты готовятся заранее.
PREGEN_HOUR_UTC=9
# Час вечерней микросцены («вечерний привал») в UTC — короткая сцена между
# утренней главой и закрытием голосования. 16:00 UTC = 19:00 Москвы.
WHISPER_HOUR_UTC=16
# Длина сюжетной арки забега в месяцах (нарратив). Копилки — календарные.
RUN_LENGTH_MONTHS=2

DATABASE_URL=sqlite+aiosqlite:///./data/the_way.db
TIMEZONE=Europe/Moscow
MEDIA_DIR=./media/generated

# Бесплатные картинки (Pollinations / Flux) и бесплатный текстовый LLM.
# Если сеть недоступна, бот сам нарисует обложку и соберёт лор из канона.
USE_FREE_IMAGES=true
USE_FREE_STORY_LLM=true
# Токен Pollinations (pollinations.ai → auth): поднимает лимиты анонимного
# tier'а. Без него общий IP Render регулярно ловит 429.
POLLINATIONS_TOKEN=
# Google Gemini Image «nano banana» (gemini-2.5-flash-image) — ПЕРВИЧНЫЙ
# генератор кадра дня при наличии ключа: aistudio.google.com → Get API key.
# Free-tier квот хватает с запасом: новый алгоритм генерирует всего 1 кадр
# в день (+1 стартовый кадр мира на день 1 забега). Без ключа бот работает
# через Pollinations, а в крайнем случае рисует детерминированную PIL-обложку.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Таймауты нейрогенераций (секунды): бесплатные модели неторопливы.
LLM_TIMEOUT_SECONDS=75
IMAGE_TIMEOUT_SECONDS=90

# Текстовый «Ведущий» (D&D-стиль): любой OpenAI-совместимый провайдер.
# Бесплатный вариант — Hugging Face: создай токен на hf.co/settings/tokens.
#   LLM_API_KEY=hf_xxxxxxxxxxxx
#   LLM_BASE_URL=https://router.huggingface.co/v1/chat/completions
#   LLM_MODELS=meta-llama/Llama-3.3-70B-Instruct
# Другие варианты: Groq (https://api.groq.com/openai/v1/chat/completions,
# LLM_MODELS=llama-3.3-70b-versatile), OpenRouter, локальная Ollama.
# Пустой ключ — бот пробует Pollinations, а без сети собирает лор офлайн.
LLM_API_KEY=
LLM_BASE_URL=https://router.huggingface.co/v1/chat/completions
LLM_MODELS=meta-llama/Llama-3.3-70B-Instruct

# Render выставит PORT и RENDER_EXTERNAL_URL сам. Локально оставь пустым — будет polling.
WEBHOOK_BASE_URL=
# Само-пинг /health раз в N секунд: держит free plan Render от засыпания,
# чтобы день открывался по UTC-сетке. 0 — выключить.
SELF_PING_SECONDS=600

# Секрет для проверки запросов к /webhook (любая случайная строка). Пусто — без проверки.
WEBHOOK_SECRET=

# === TON-ставки (пока каркас, выключено) ===
# Включать только когда всё готово: казначейский кошелёк, watcher, выплаты.
TON_ENABLED=false
# Контур: mainnet или testnet. Testnet — отдельный «второй контур» для проверки:
# свой казначейский кошелёк, свои лимиты API, ставки помечаются сетью и не смешиваются.
TON_NETWORK=mainnet
# Адрес казначейского кошелька (сюда приходят ставки).
TREASURY_ADDRESS=
# Мнемоника казначея (24 слова). Только в секретах Render! Нужна для выплат победителям.
TREASURY_MNEMONIC=
# То же для тестнет-контура (кошелёк из https://t.me/testgiver_ton_bot).
TREASURY_TESTNET_ADDRESS=
TREASURY_TESTNET_MNEMONIC=
# Версия контракта казначея: auto (детект по адресу), v4r2 или v5r1.
# Современные кошельки (Tonkeeper и др.) созданы как v5r1.
TREASURY_WALLET_VERSION=auto
# Свежий JSON-конфиг лайтсерверов для исходящих переводов (pytoniq, ADNL/UDP).
# Встроенный конфиг тестнета периодически мёртв — выплаты встают с ошибкой
# «have no alive peers». Лечение: официальный тестнет-конфиг
LITESERVER_CONFIG_URL=https://ton.org/testnet-global.config.json
# TonAPI (tonapi.io) или toncenter. Ключ повышает лимиты запросов.
TON_API_BASE=https://tonapi.io
TON_API_BASE_TESTNET=https://testnet.tonapi.io
TON_API_KEY=
# Фолбэк-источник истории переводов (Toncenter API v3). Включается сам,
# когда TonAPI лжёт (404 истории при живом казначее) или лежит совсем.
# Ключ: https://t.me/toncenter_bot — повышает лимиты запросов.
TONCENTER_API_BASE=https://toncenter.com
TONCENTER_API_BASE_TESTNET=https://testnet.toncenter.com
TONCENTER_API_KEY=
# Лимиты ставки на игрока в день и распределение фонда дня, %:
# 97% — ставившим на верный путь пропорционально,
# WEEKLY_POT_PCT — копилка недели (в понедельник её делят топ-3 /top),
# OWNER_RAKE_PCT — хранителю игры, LEADERBOARD_RAKE_PCT — в копилку месяца (/top).
STAKE_MIN_TON=0.1
OWNER_RAKE_PCT=0.5
LEADERBOARD_RAKE_PCT=0.5
WEEKLY_POT_PCT=2
# Недельный лидерборд: минимум дней голосования за неделю для призового места
# (анти-мультиаккаунт) и доли мест 1-й/2-й/3-й в процентах.
WEEKLY_MIN_DAYS=4
WEEKLY_PRIZE_PCTS=20,30,50
# Куда уходят рейк и копилка месяца (владелец держит до выплаты лидерам месяца).
OWNER_WALLET_ADDRESS=
# Сколько секунд должно пройти после транзакции, чтобы ставка считалась подтверждённой.
STAKE_CONFIRM_SECONDS=40
# Сколько раз зависшая выплата ретраится, прежде чем окончательно встать в failed.
PAYOUT_MAX_ATTEMPTS=5
# Глубина скана входящих переводов казначея за цикл наблюдателя (раз в минуту):
# до WATCH_MAX_PAGES страниц по WATCH_PAGE_LIMIT транзакций. Курсор в БД делает
# покрытие кумулятивным — после простоя хвост догоняется за пару циклов.
WATCH_PAGE_LIMIT=100
WATCH_MAX_PAGES=50
# Грубый стоп-фильтр генераций перед постингом в чаты (мат и слуры).
CONTENT_FILTER=true
# Личное эхо проигравшим: после итогов каждый, кто голосовал мимо победителя,
# получает в личку короткое «чем пахла бы его тропа». false — выключить.
PERSONAL_ECHO=true
# Мир игры: название попадает на картинки и в тексты бота, brief — в промпт
# нейросети. Поменяв их, получишь другой мир с той же механикой.
WORLD_NAME=Эхо Стаи
WORLD_BRIEF=Фанатская история по мотивам Lost Dogs, не связанная с официальной командой. До этого была другая Стая и другая игра: ровная, предсказуемая, где один сон снился миллионам лап сразу. Её ветеран — пёс по прозвищу Еретик, Свернувший с Пути — заскучал первым и увёл тех, кому стало тесно, через Последний Путь. Теперь Стая живёт в сети нестабильных миров-порталов, где правила переписаны заново: закон дня бывает разным, память ходит по кругу как валюта, а где-то в глубине сети звучит Первый Лай. По следу стаи идёт Хозяин Ошибки, мечтающий вернуть всем ровный сон без единой ошибки.

# === Платная смена выбора ===
# 23 часа на раздумья; передумать — платно: Telegram Stars или TON с memo rv:<день>.
REVOTE_ENABLED=true
REVOTE_STARS=25
REVOTE_TON=0.1

# === Глухой день ===
# Раз в N дней закон дня не объявляется утром (только хеш), вскрывается в итогах. 0 — выключить.
SEALED_DAY_EVERY=10

