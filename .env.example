BOT_TOKEN=
ADMIN_IDS=

# Прод: 82800 и 3600. Для проверки: 120 и 30.
ROUND_SECONDS=82800
TALLY_SECONDS=3600
# Сетка расписания (UTC): день открывается в этот час, голосование до (час-1):00,
# час подсчёта — и сразу после него итоги с новым днём.
DAY_OPEN_HOUR_UTC=11

DATABASE_URL=sqlite+aiosqlite:///./data/the_way.db
TIMEZONE=Europe/Moscow
MEDIA_DIR=./media/generated

# Бесплатные картинки (Pollinations / Flux) и бесплатный текстовый LLM.
# Если сеть недоступна, бот сам нарисует карты и соберёт лор из канона.
USE_FREE_IMAGES=true
USE_FREE_STORY_LLM=true

# Текстовый «Ведущий» (D&D-стиль): любой OpenAI-совместимый провайдер.
# Бесплатный вариант — Hugging Face: создай токен на hf.co/settings/tokens.
#   LLM_API_KEY=hf_xxxxxxxxxxxx
#   LLM_BASE_URL=https://router.huggingface.co/v1/chat/completions
#   LLM_MODELS=meta-llama/Llama-3.3-70B-Instruct
# Другие варианты: Groq (https://api.groq.com/openai/v1/chat/completions,
# LLM_MODELS=llama-3.3-70b-versatile), OpenRouter, локальная Ollama.
# Пустой ключ — бот пробует Pollinations, а без сети собирает лор офлайн.
LLM_API_KEY=
LLM_BASE_URL=https://router.huggingface.co/v1/chat/completions
LLM_MODELS=meta-llama/Llama-3.3-70B-Instruct

# Render выставит PORT и RENDER_EXTERNAL_URL сам. Локально оставь пустым — будет polling.
WEBHOOK_BASE_URL=

# Секрет для проверки запросов к /webhook (любая случайная строка). Пусто — без проверки.
WEBHOOK_SECRET=

# === TON-ставки (пока каркас, выключено) ===
# Включать только когда всё готово: казначейский кошелёк, watcher, выплаты.
TON_ENABLED=false
# Контур: mainnet или testnet. Testnet — отдельный «второй контур» для проверки:
# свой казначейский кошелёк, свои лимиты API, ставки помечаются сетью и не смешиваются.
TON_NETWORK=mainnet
# Адрес казначейского кошелька (сюда приходят ставки).
TREASURY_ADDRESS=
# Мнемоника казначея (24 слова). Только в секретах Render! Нужна для выплат победителям.
TREASURY_MNEMONIC=
# То же для тестнет-контура (кошелёк из https://t.me/testgiver_ton_bot).
TREASURY_TESTNET_ADDRESS=
TREASURY_TESTNET_MNEMONIC=
# TonAPI (tonapi.io) или toncenter. Ключ повышает лимиты запросов.
TON_API_BASE=https://tonapi.io
TON_API_BASE_TESTNET=https://testnet.tonapi.io
TON_API_KEY=
# Лимиты ставки на игрока в день и распределение фонда дня, %:
# 97% — ставившим на верный путь пропорционально,
# 2% — угадавшим без ставки поровну,
# OWNER_RAKE_PCT — хранителю игры, LEADERBOARD_RAKE_PCT — в копилку месяца (/top).
STAKE_MIN_TON=0.1
STAKE_MAX_TON=10
OWNER_RAKE_PCT=0.5
LEADERBOARD_RAKE_PCT=0.5
FREE_WINNERS_PCT=2
# Куда уходят рейк и копилка месяца (владелец держит до выплаты лидерам месяца).
OWNER_WALLET_ADDRESS=
# Сколько секунд должно пройти после транзакции, чтобы ставка считалась подтверждённой.
STAKE_CONFIRM_SECONDS=40
# Сколько раз зависшая выплата ретраится, прежде чем окончательно встать в failed.
PAYOUT_MAX_ATTEMPTS=5
# Глубина скана входящих переводов казначея за цикл наблюдателя (раз в минуту):
# до WATCH_MAX_PAGES страниц по WATCH_PAGE_LIMIT транзакций. Курсор в БД делает
# покрытие кумулятивным — после простоя хвост догоняется за пару циклов.
WATCH_PAGE_LIMIT=100
WATCH_MAX_PAGES=50
# Грубый стоп-фильтр генераций перед постингом в чаты (мат и слуры).
CONTENT_FILTER=true
# Мир игры: название попадает на картинки и в тексты бота, brief — в промпт
# нейросети. Поменяв их, получишь другой мир с той же механикой.
WORLD_NAME=Эхо Стаи
WORLD_BRIEF=Фанатская история по мотивам Lost Dogs, не связанная с официальной командой. После Последнего Пути Стая потерянных собак нашла сеть нестабильных миров-порталов: каждый мир собран из чужих решений и воспоминаний. Порталы глючат и путают ветки реальности, Архивариусы хранят спорные версии событий, мутанты слышат то, чего ещё не было, а где-то в глубине сети звучит Первый Лай — зов домой или ловушка, не знает никто.

# === Платная смена выбора ===
# 23 часа на раздумья; передумать — платно: Telegram Stars или TON с memo rv:<день>.
REVOTE_ENABLED=true
REVOTE_STARS=25
REVOTE_TON=0.1

